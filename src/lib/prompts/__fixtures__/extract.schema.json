{
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "Address / location"
    },
    "propertyType": {
      "type": "string",
      "description": "Property type"
    },
    "yearBuilt": {
      "type": "string",
      "description": "Year built / approx. age"
    },
    "keyFeatures": {
      "type": "string",
      "description": "Key features"
    },
    "targetAudience": {
      "type": "string",
      "description": "Likely buyer Comma-separated, only from: First-time buyer, Growing family, Downsizer, Investor, Commuter, Chain-free buyer."
    },
    "price": {
      "type": "string",
      "description": "Asking price (£)"
    },
    "priceQualifier": {
      "type": "string",
      "description": "Price qualifier One of: Guide Price | Offers in Excess of | Offers in the Region of | Offers Over | Fixed Price | From | Shared Ownership."
    },
    "tenure": {
      "type": "string",
      "description": "Tenure One of: Freehold | Leasehold | Share of freehold | Commonhold."
    },
    "chainStatus": {
      "type": "string",
      "description": "Chain One of: No onward chain | Chain involved | Not known."
    },
    "leaseYears": {
      "type": "string",
      "description": "Lease remaining (yrs)"
    },
    "groundRent": {
      "type": "string",
      "description": "Ground rent (£ per year)"
    },
    "groundRentReview": {
      "type": "string",
      "description": "Ground rent review"
    },
    "serviceCharge": {
      "type": "string",
      "description": "Service charge (£ per year)"
    },
    "serviceChargePeriod": {
      "type": "string",
      "description": "Service charge period"
    },
    "reserveFund": {
      "type": "string",
      "description": "Reserve fund / event fees"
    },
    "sharePercent": {
      "type": "string",
      "description": "Share offered (%)"
    },
    "rent": {
      "type": "string",
      "description": "Rent on unsold share (£/month)"
    },
    "fullMarketValue": {
      "type": "string",
      "description": "Full market value (£)"
    },
    "saleMethod": {
      "type": "string",
      "description": "Sale method One of: Private treaty | Traditional auction | Modern Method of Auction. Only when stated; \"MMoA\" / \"modern method\" → \"Modern Method of Auction\"."
    },
    "saleStatus": {
      "type": "string",
      "description": "Sale status One of: Available | Under offer – still marketing | Sold subject to contract."
    },
    "auctionTerms": {
      "type": "string",
      "description": "Auction terms"
    },
    "reservationFee": {
      "type": "string",
      "description": "Reservation fee"
    },
    "buyerFees": {
      "type": "string",
      "description": "Buyer's fees"
    },
    "preMarket": {
      "type": "string",
      "description": "Pre-market / coming soon? One of: Yes | No."
    },
    "newBuild": {
      "type": "string",
      "description": "New home? One of: Yes | No. Yes only when the agent says it is a new build / new home."
    },
    "incentives": {
      "type": "string",
      "description": "Incentives (with end date)"
    },
    "estateCharge": {
      "type": "string",
      "description": "Estate / management charge (£ per year)"
    },
    "ageRestriction": {
      "type": "string",
      "description": "Age / occupancy restriction"
    },
    "eventFees": {
      "type": "string",
      "description": "Event fees (retirement)"
    },
    "bedrooms": {
      "type": "string",
      "description": "Bedrooms"
    },
    "bathrooms": {
      "type": "string",
      "description": "Bathrooms"
    },
    "receptions": {
      "type": "string",
      "description": "Receptions"
    },
    "dimensions": {
      "type": "string",
      "description": "Room dimensions"
    },
    "periodFeatures": {
      "type": "string",
      "description": "Period / character features"
    },
    "outsideSpace": {
      "type": "string",
      "description": "Outside space / garden"
    },
    "councilTaxBand": {
      "type": "string",
      "description": "Council Tax band One of: A | B | C | D | E | F | G | H | I | Exempt | Not yet banded."
    },
    "localAuthority": {
      "type": "string",
      "description": "Local authority"
    },
    "epc": {
      "type": "string",
      "description": "EPC rating One of: A | B | C | D | E | F | G | Exempt | Commissioned."
    },
    "epcPredicted": {
      "type": "string",
      "description": "EPC predicted? One of: Yes | No. Yes only when the agent says the EPC is predicted (SAP / new build)."
    },
    "construction": {
      "type": "string",
      "description": "Construction One of: Standard | Non-standard."
    },
    "constructionDetails": {
      "type": "string",
      "description": "Construction details"
    },
    "electricity": {
      "type": "string",
      "description": "Electricity"
    },
    "water": {
      "type": "string",
